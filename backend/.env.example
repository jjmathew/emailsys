PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Google OAuth2 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Anthropic API key (from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Ollama (open source LLM — runs locally, free)
# Install: brew install ollama && ollama pull llama3.2 && ollama serve
# Set OLLAMA_MODEL to enable; Ollama takes priority over Anthropic when set
OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434  # default, change if running elsewhere

# Session secret (use a long random string in production)
SESSION_SECRET=change-this-to-a-random-secret
